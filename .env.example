# App
NODE_ENV=development
HOST=http://localhost
PORT=4000
DOMAIN=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=super_secret
JWT_EXPIRATION_TIME=12h
JWT_REFRESH_SECRET=super_secret_refresh
JWT_REFRESH_EXPIRATION_TIME=7d
JWT_INVITE_SECRET=super_secret_invite
JWT_INVITE_EXPIRATION_TIME=7d
JWT_RESET_PASSWORD_SECRET=super_secret_reset_password
JWT_RESET_PASSWORD_EXPIRATION_TIME=1h

# Database (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=learning_app
MIGRATIONS_RUN=false
DB_AUTO_SYNCHRONIZE_ENTITY=false
DB_LOGGING_DEBUG=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Audit log
AUDIT_LOG_ENABLED=true
AUDIT_LOG_READ_ACTIONS=false
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_EXCLUDE_ROUTES=/health,/api/v1/docs

# MinIO (optional)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=learning-app
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=localhost:9000

# Elasticsearch (optional)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
